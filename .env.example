# Optional Gemini key used only if an AI feature is enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Firebase Admin credentials for the Vercel API.
# Never commit the real private key.
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-firebase-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Firebase client configuration is provided by firebase-applet-config.json in this project.
# Configure Google sign-in and Firestore in the Firebase console.
