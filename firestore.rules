rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    // Sensitive progression documents are read-only to authenticated owners on the client.
    // All mutations and writes MUST occur through the trusted backend using Firebase Admin SDK.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /stats/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /quests/{questId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /inventory/{inventoryId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /questHistory/{historyId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /userAchievements/{userAchievementId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
  }
}
